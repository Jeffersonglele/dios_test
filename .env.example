NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/dios_delices?schema=public
POSTGRES_DB=dios_delices
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_EXPIRES_IN=7d
DEFAULT_USER_ROLE_ID=2
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Dios Délices <your-gmail-address@gmail.com>"
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
ADMIN_ROLE_IDS=1
RESTAURATEUR_ROLE_IDS=3
LIVREUR_ROLE_IDS=4

# Delivery launch settings (CDF). The server keeps the final quote as a snapshot on each order.
ROUTE_DISTANCE_FACTOR=1.25
COURIER_LOCATION_MAX_AGE_MINUTES=5
DISPATCH_OFFER_LIMIT=3
DISPATCH_OFFER_TTL_SECONDS=60
TIP_MAX_CDF=50000

# Public OSM/Nominatim policy: use an identifiable application and contact address.
NOMINATIM_USER_AGENT=DiosDelices/1.0 (contact: support@example.cd)

# Media storage. Keep "local" for local/Render flow tests.
# On paid Render, attach a persistent disk at /var/data and use /var/data/uploads.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:3000
# Render provides RENDER_EXTERNAL_URL automatically for the deployed API.

# Set these only when STORAGE_DRIVER=minio.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dios-delices-media
MINIO_PUBLIC_URL=

# Nyole: use test while integrating, live only after validation.
# Never expose these secret keys to Flutter or commit real values.
NYOLE_MODE=test
NYOLE_API_BASE_URL=https://app.nyole.com/api
NYOLE_LIVE_SECRET_KEY=
NYOLE_TEST_SECRET_KEY=
NYOLE_SUCCESS_URL=http://localhost:3000/api/v1/payments/nyole/return?status=success
NYOLE_CANCEL_URL=http://localhost:3000/api/v1/payments/nyole/return?status=cancelled


SEED_PASSWORD=.....
