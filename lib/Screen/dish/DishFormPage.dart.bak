                          final validChoices = choiceCtls.map((c) => c.text.trim()).where((c) => c.isNotEmpty).toList();
                          if (validChoices.isEmpty) { Toast(context, "Au moins un choix est obligatoire", false); return; }
                          final priceStr = priceCtrl.text.trim();
