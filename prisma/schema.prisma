// PostgreSQL schema for Dios Delices.
// Fields come from dios-delices-backend/schema/schema.json. Legacy numeric IDs
// and aliases are retained to make the Parse -> PostgreSQL import lossless.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte d’authentification utilisé pour la connexion et le mot de passe.
model AuthUser {
  id             String         @id @default(uuid()) @db.Uuid
  parseObjectId  String?        @unique
  username       String         @unique
  password       String
  email          String?        @unique
  emailVerified  Boolean        @default(false)
  authData       Json?
  acl            Json?
  firstname      String?
  lastname       String?
  telephone      String?
  telephoneLocal String?
  telephoneE164  String?
  legacyUserId   Int?           @unique
  image          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  memberships    AuthUserRole[]

  @@map("auth_users")
  @@index([firstname])
}

/// Rôle technique d’authentification et ses règles d’accès éventuelles.
model AuthRole {
  id            String         @id @default(uuid()) @db.Uuid
  parseObjectId String?        @unique
  name          String         @unique
  acl           Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   AuthUserRole[]
  parents       AuthRoleLink[] @relation("ChildRole")
  children      AuthRoleLink[] @relation("ParentRole")

  @@map("auth_roles")
}

/// Table de liaison entre les comptes d’authentification et leurs rôles.
model AuthUserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("auth_user_roles")
}

/// Hiérarchie entre rôles parent et rôles enfant.
model AuthRoleLink {
  parentRoleId String   @db.Uuid
  childRoleId  String   @db.Uuid
  createdAt    DateTime @default(now())
  parentRole   AuthRole @relation("ParentRole", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole    AuthRole @relation("ChildRole", fields: [childRoleId], references: [id], onDelete: Cascade)

  @@id([parentRoleId, childRoleId])
  @@map("auth_role_links")
}

/// Profil métier de l’utilisateur, séparé du compte technique `AuthUser`.
model User {
  id             String    @id @default(uuid()) @db.Uuid
  /// Identifiant Parse conservé pour assurer la correspondance avec l’ancien système.
  parseObjectId  String?   @unique
  userId         Int?      @unique
  firstname      String?
  lastname       String?
  username       String?
  email          String?
  password       String?
  telephone      String?
  telephoneLocal String?
  telephoneE164  String?
  roleId         Int?
  country        String?
  status         String?
  identity       String?
  addressId      Int?
  lastLogin      DateTime?
  image          String?
  parrain        String?
  cityId         Int?
  courierStatus  String?   @map("courier_status")
  /// Position courante du livreur, stockée en géographie PostGIS.
  location       Unsupported("geography(Point,4326)")?
  locationUpdatedAt DateTime? @map("location_updated_at")
  phoneVerified  Boolean   @default(false)
  accountType    String?
  otpPhone       String?
  ageConfirmed   Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
  @@index([firstname])
  @@index([cityId])
  @@index([email, telephone, username])
  @@index([roleId])
}

/// Rôle métier historique conservé pour les données importées.
model Role {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  roleId        Int?      @unique
  name          String?
  nbUsers       Int?
  nbWaiting     Int?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("roles")
}

/// Fichier média associé au catalogue ou à un autre objet métier.
model Gallery {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  fileUrl       String
  name          String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("gallery")
}

/// Point de vente présent dans le catalogue Dios Délices.
model Restaurant {
  id                String    @id @default(uuid()) @db.Uuid
  /// Identifiant numérique historique utilisé par les commandes et les imports.
  parseObjectId     String?   @unique
  restaurantId      Int?      @unique
  userId            Int?
  categories        String?
  description       String?
  address           String?   @map("adress")
  addressId         Int?
  name              String?
  rating            Float?    @map("note")
  image             String?
  dateCreation      DateTime?
  valid             Int?
  orderCount        Int?      @map("nb_orders")
  openingHours      String?
  deliveryFee       Decimal?  @db.Decimal(14, 2)
  isOpen            Int?
  professionalType  String?
  trainingCompleted Boolean   @default(false)
  reviewRemark      String?
  currency          String?
  openingDays       String?
  minOrderAmount    Decimal?  @db.Decimal(14, 2)
  deliveryRadius    Float?
  latitude          Float?
  longitude         Float?
  /// Position fixe du restaurant dans PostGIS.
  location          Unsupported("geography(Point,4326)")?
  locationUpdatedAt DateTime? @map("location_updated_at")
  closedDates       String?
  recoveryMode      String?
  country           String?
  isPro             Boolean   @default(false)
  cityId            Int?
  rccm              String?
  paymentMethod     String?
  mobileMoneyPhone  String?
  iban              String?
  bankName          String?
  accountHolder     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("restaurants")
  @@index([userId])
  @@index([name])
  @@index([cityId])
}

/// Plat vendu par un restaurant.
model Dish {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  dishId        Int?      @unique
  userId        Int?
  restaurantId  Int?      @map("restau_id")
  name          String?
  categories    String?
  image         String?
  images        String?
  orderCount    Int?      @map("nb_orders")
  price         Decimal?  @db.Decimal(14, 2)
  description   String?
  servings      Int?      @map("nb_servings")
  status        Int?
  rating        Float?    @map("note")
  option1       String?
  option2       String?
  option3       String?
  currency      String?
  country       String?
  cityId        Int?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("dishes")
  @@index([restaurantId, name])
  @@index([cityId])
  @@index([userId])
}

/// Commentaire laissé par un utilisateur sur une cible métier.
model Comment {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  commentId     Int?      @unique
  userId        Int?
  target        Int?
  targetId      Int?
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("comments")
  @@index([target, targetId])
  @@index([userId])
}

/// Adresse enregistrée pour un utilisateur, enrichie de coordonnées GPS.
model Address {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  addressId     Int       @unique
  objectType    String?   @map("object")
  objectId      Int?
  streetNumber  Int?      @map("numero")
  city          String?
  state         String?
  country       String?
  fullAddress   String?
  latitude      Float?    @map("lat")
  longitude     Float?    @map("long")
  cityId        Int?
  /// Position GPS de l’adresse, utilisée pour vérifier la zone de livraison.
  location      Unsupported("geography(Point,4326)")?
  locationSource String?  @map("location_source")
  locationUpdatedAt DateTime? @map("location_updated_at")
  nominatimPlaceId String? @map("nominatim_place_id")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("addresses")
  @@index([latitude, longitude, objectType, objectId])
}

/// Dossier de vérification de l’identité d’un utilisateur.
model Identity {
  id              String    @id @default(uuid()) @db.Uuid
  parseObjectId   String?   @unique
  identityId      Int?      @unique
  userId          Int?
  identityFileUrl String?   @map("piece_identite")
  photoUrl        String?   @map("photo")
  status          String?
  remark          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("identities")
  @@index([userId])
}

/// Moyen de paiement enregistré pour un utilisateur.
model PaymentMethod {
  id              String    @id @default(uuid()) @db.Uuid
  parseObjectId   String?   @unique
  paymentMethodId Int?      @unique @map("id_moyen")
  externalId      String?   @map("id_moyen_paiement")
  name            String?   @map("nom")
  label           String?   @map("libelle")
  userId          Int?
  stripePaymentId String?   @map("stripe_pm_id")
  brand           String?
  last4           Int?
  expirationMonth Int?      @map("exp_month")
  expirationYear  Int?      @map("exp_year")
  type            String?
  isDefault       Boolean   @default(false) @map("is_default")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("payment_methods")
  @@index([userId])
}

/// Commande client, avec ses montants, son statut et ses instantanés de livraison.
model Order {
  id                       String    @id @default(uuid()) @db.Uuid
  parseObjectId            String?   @unique
  orderId                  Int?      @unique @map("commande_id")
  externalOrderId          String?   @map("id_commande")
  userId                   Int?
  legacyUserId             Int?      @map("id_user")
  restaurantId             Int?      @map("restau_id")
  legacyRestaurantId       Int?      @map("id_restau")
  restaurateurId           Int?
  legacyRestaurateurId     Int?      @map("id_restaurateur")
  paymentMethodId          Int?      @map("moyen_paiement_id")
  externalPaymentId        String?   @map("id_moyen_paiement")
  deliveryFee              Decimal?  @map("frais_livraison") @db.Decimal(14, 2)
  legacyDeliveryFee        Decimal?  @map("fraisLivraison") @db.Decimal(14, 2)
  reduction                Decimal?  @db.Decimal(14, 2)
  globalReduction          Decimal?  @map("reduction_globale") @db.Decimal(14, 2)
  orderedAt                DateTime? @map("date_commande")
  legacyOrderedAt          DateTime? @map("dateCommande")
  orderedTime              String?   @map("heure")
  addressId                Int?
  deliveryAddressId        Int?      @map("id_adresse_livraison")
  rating                   Float?    @map("note")
  comment                  String?   @map("commentaire")
  status                   String?
  legacyStatus             String?   @map("statut")
  orderStatus              String?   @map("statut_commande")
  currency                 String?
  promoCode                String?   @map("promo_code")
  deliveryMode             String?
  subtotalAmount           Decimal?  @db.Decimal(14, 2)
  totalAmount              Decimal?  @db.Decimal(14, 2)
  delivererId              Int?      @map("livreur_id")
  deliveryStatus           String?
  country                  String?
  isPro                    String?
  delivererName            String?   @map("livreur_nom")
  livraisonStatus          String?
  livraisonDate            String?
  delivererLatitude        Float?    @map("livreur_lat")
  delivererLongitude       Float?    @map("livreur_lng")
  cityId                   Int?
  paymentProvider          String?
  tipAmount                Decimal?  @db.Decimal(14, 2)
  delivererBasePay         Decimal?  @db.Decimal(14, 2)
  delivererDistancePay     Decimal?  @db.Decimal(14, 2)
  delivererEarningsStatus  String?
  deliveryDistanceKm       Decimal?  @map("delivery_distance_km") @db.Decimal(10, 3)
  /// Copie du devis utilisé au moment de la création, pour garantir la traçabilité.
  deliveryQuoteSnapshot    Json?     @map("delivery_quote_snapshot")
  /// Adresse client figée dans la commande, même si l’adresse est modifiée ensuite.
  deliveryAddressSnapshot  Json?     @map("delivery_address_snapshot")
  /// Informations du point de retrait figées dans la commande.
  pickupSnapshot           Json?     @map("pickup_snapshot")
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("orders")
  @@index([userId])
  @@index([restaurantId])
  @@index([restaurateurId])
  @@index([delivererId])
  @@index([cityId])
  @@index([status])
}

/// Ligne d’une commande : plat, quantité, prix et options choisies.
model OrderLine {
  id              String    @id @default(uuid()) @db.Uuid
  parseObjectId   String?   @unique
  lineId          String?   @unique @map("ligne_id")
  legacyLineId    String?   @map("id_ligne_commande")
  orderId         String?   @map("commande_id")
  externalOrderId String?   @map("id_commande")
  dishId          Int?      @map("plat_id")
  legacyDishId    Int?      @map("id_plat")
  quantity        Int?
  unitPrice       Decimal?  @map("prix_unitaire") @db.Decimal(14, 2)
  legacyUnitPrice Decimal?  @map("prixUnitaire") @db.Decimal(14, 2)
  reduction       Decimal?  @db.Decimal(14, 2)
  rating          Float?    @map("note")
  comment         String?   @map("commentaire")
  options         Json?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("order_lines")
  @@index([orderId])
  @@index([dishId])
}

/// Message échangé entre utilisateurs, éventuellement lié à une commande.
model Message {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  fromUserId    Int?
  toUserId      Int?
  text          String?
  orderId       Int?      @map("commande_id")
  read          Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("messages")
  @@index([fromUserId])
  @@index([toUserId])
  @@index([orderId])
}

/// Historique des connexions des utilisateurs.
model UserLogin {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  userId        Int?
  username      String?
  ip            String?
  loginAt       DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user_logins")
  @@index([userId])
  @@index([loginAt])
}

/// Signalement d’un contenu ou d’un objet métier par un utilisateur.
model Report {
  id             String    @id @default(uuid()) @db.Uuid
  parseObjectId  String?   @unique
  reporterUserId Int?
  targetType     Int?
  targetId       Int?
  reason         String?
  details        String?
  status         String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("reports")
  @@index([reporterUserId])
  @@index([targetType, targetId])
}

/// Document professionnel soumis pour validation d’un restaurant ou d’un compte.
model ProDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  parseObjectId      String?   @unique
  documentId         Int?      @unique
  userId             Int?
  restaurantId       Int?
  siretUrl           String?
  kbisUrl            String?
  identityDocumentUrl String?  @map("piece_identite_url")
  description        String?
  status             String?
  remark             String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("pro_documents")
  @@index([userId])
  @@index([restaurantId])
}

/// Code temporaire utilisé pour une vérification ou une réinitialisation.
model VerificationCode {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  email         String
  code          String
  expiresAt     DateTime
  phone         String?
  purpose       String?
  attempts      Int       @default(0)
  blockedUntil  DateTime?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("verification_codes")
  @@index([email, purpose])
  @@index([phone, purpose])
  @@index([expiresAt])
}

/// Code promotionnel et règles de réduction applicables à une commande.
model PromoCode {
  id              String    @id @default(uuid()) @db.Uuid
  parseObjectId   String?   @unique
  code            String    @unique
  description     String?
  discountPercent Float?
  discountFixed   Decimal?  @db.Decimal(14, 2)
  minOrder        Decimal?  @db.Decimal(14, 2)
  validFrom       DateTime?
  validUntil      DateTime?
  active          Boolean   @default(true)
  maxUses         Int?
  usedCount       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promo_codes")
  @@index([active, validUntil])
}

/// Catégorie affichée dans le catalogue.
model Category {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  categoryId    Int?      @unique
  name          String?
  image         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("categories")
  @@index([name])
}

/// Ville dans laquelle la livraison peut être activée.
model City {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  cityId        Int       @unique
  name          String
  country       String?
  countryCode   String    @default("CD") @map("country_code")
  /// Limite géographique de la ville utilisée par les contrôles PostGIS.
  boundary      Unsupported("geometry(MultiPolygon,4326)")?
  deliveryEnabled Boolean @default(true) @map("delivery_enabled")
  active        Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("cities")
  @@index([country, active])
}

/// Zone de livraison rattachée à une ville et définie par un polygone.
model DeliveryZone {
  id               String    @id @default(uuid()) @db.Uuid
  parseObjectId    String?   @unique
  zoneId           Int       @unique
  cityId           Int
  name             String
  /// Ancien polygone JSON conservé pour compatibilité avec les données importées.
  polygon          String
  /// Version PostGIS du polygone, utilisée pour les recherches géographiques.
  boundary         Unsupported("geometry(MultiPolygon,4326)")?
  deliveryTimeMin  Int?      @map("delivery_time_min")
  deliveryTimeMax  Int?      @map("delivery_time_max")
  deliveryFeeLevel String?   @map("delivery_fee_level")
  priority         String?
  active           Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("delivery_zones")
  @@index([cityId])
  @@index([active])
}

/// Transaction financière liée à une commande ou à un pourboire.
model Transaction {
  id                String    @id @default(uuid()) @db.Uuid
  parseObjectId     String?   @unique
  transactionId     String    @unique
  orderId           Int       @map("commande_id")
  provider          String
  amount            Decimal   @db.Decimal(14, 2)
  currency          String?
  status            String?
  providerRef       String?
  operator          String?
  phone             String?
  paymentMethod     String?
  /// Réponse et métadonnées du prestataire, par exemple CinetPay.
  providerData      Json?
  settlementStatus  String?
  commissionRate    Float?
  subtotalAmount    Decimal?  @db.Decimal(14, 2)
  commissionAmount  Decimal?  @db.Decimal(14, 2)
  restaurantShare   Decimal?  @db.Decimal(14, 2)
  deliveryFeeShare  Decimal?  @db.Decimal(14, 2)
  settledAt         DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("transactions")
  @@index([orderId])
  @@index([status])
}

/// Paramètres de calcul des frais de livraison et de la rémunération.
model DeliveryConfig {
  id                   String    @id @default(uuid()) @db.Uuid
  parseObjectId        String?   @unique
  configId             Int       @unique
  cityId               Int?      @map("city_id")
  /// Frais fixes appliqués au début du calcul de livraison.
  baseFee              Decimal   @db.Decimal(14, 2)
  /// Tarif appliqué à chaque kilomètre facturable.
  perKmRate            Decimal   @db.Decimal(14, 2)
  includedDistanceKm   Decimal?  @map("included_distance_km") @db.Decimal(10, 3)
  maxDistanceKm        Decimal?  @map("max_distance_km") @db.Decimal(10, 3)
  fuelPricePerLitre    Decimal?  @map("fuel_price_per_litre") @db.Decimal(14, 2)
  fuelSurcharge        Decimal?  @map("fuel_surcharge") @db.Decimal(14, 2)
  demandMultiplier     Decimal?  @map("demand_multiplier") @default(1) @db.Decimal(6, 3)
  weatherMultiplier    Decimal?  @map("weather_multiplier") @default(1) @db.Decimal(6, 3)
  roundingIncrement    Decimal?  @map("rounding_increment") @default(50) @db.Decimal(14, 2)
  currency             String?
  minFee               Decimal?  @db.Decimal(14, 2)
  updatedBy            Int?
  active               Boolean   @default(true)
  commissionRate       Float?
  exchangeRate         Decimal?  @db.Decimal(18, 6)
  delivererBasePay     Decimal?  @db.Decimal(14, 2)
  delivererPerKm       Decimal?  @db.Decimal(14, 2)
  subscriptionsEnabled Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("delivery_configs")
  @@index([cityId, active])
}

/// Course de livraison créée à partir d’une commande.
model Delivery {
  id                  String    @id @default(uuid()) @db.Uuid
  deliveryId          String    @unique @default(uuid()) @map("delivery_id")
  orderId             Int       @unique @map("commande_id")
  cityId              Int       @map("city_id")
  restaurantId        Int?      @map("restaurant_id")
  delivererId         Int?      @map("livreur_id")
  /// Cycle de vie de la course : SEARCHING, ASSIGNED, PICKED_UP, DELIVERED, etc.
  status              String    @default("SEARCHING")
  dispatchAttempt     Int       @default(0) @map("dispatch_attempt")
  pickupLatitude      Float?    @map("pickup_latitude")
  pickupLongitude     Float?    @map("pickup_longitude")
  deliveryLatitude    Float?    @map("delivery_latitude")
  deliveryLongitude   Float?    @map("delivery_longitude")
  quotedDistanceKm    Decimal?  @map("quoted_distance_km") @db.Decimal(10, 3)
  acceptedAt          DateTime? @map("accepted_at")
  pickedUpAt          DateTime? @map("picked_up_at")
  deliveredAt         DateTime? @map("delivered_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationReason  String?   @map("cancellation_reason")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("deliveries")
  @@index([cityId, status])
  @@index([delivererId, status])
}

/// Proposition d’une course envoyée à un livreur.
model DeliveryOffer {
  id           String    @id @default(uuid()) @db.Uuid
  deliveryId   String    @map("delivery_id")
  delivererId  Int       @map("livreur_id")
  rank         Int
  status       String    @default("PENDING")
  /// Date limite après laquelle l’offre n’est plus acceptée.
  expiresAt    DateTime? @map("expires_at")
  respondedAt  DateTime? @map("responded_at")
  distanceToPickupKm Decimal? @map("distance_to_pickup_km") @db.Decimal(10, 3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("delivery_offers")
  @@unique([deliveryId, delivererId])
  @@index([delivererId, status])
}

/// Dernières positions GPS enregistrées pour les livreurs actifs.
model CourierLocation {
  id          String    @id @default(uuid()) @db.Uuid
  delivererId Int       @map("livreur_id")
  cityId      Int?      @map("city_id")
  latitude    Float
  longitude   Float
  location    Unsupported("geography(Point,4326)")?
  accuracyM   Float?    @map("accuracy_m")
  recordedAt  DateTime  @default(now()) @map("recorded_at")
  createdAt   DateTime  @default(now())

  @@map("courier_locations")
  @@index([delivererId, recordedAt])
  @@index([cityId, recordedAt])
}

/// Numéro Mobile Money enregistré par un utilisateur pour de futurs paiements.
model MobileMoneyAccount {
  id          String    @id @default(uuid()) @db.Uuid
  userId      Int       @map("user_id")
  /// Opérateur normalisé : MPESA, ORANGE_MONEY ou AIRTEL_MONEY.
  operator    String
  /// Numéro au format international RDC (+243...).
  phoneE164   String    @map("phone_e164")
  label       String?
  verified    Boolean   @default(false)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("mobile_money_accounts")
  @@unique([userId, operator, phoneE164])
  @@index([userId, isDefault])
}

/// Compte portefeuille Dios associé à un utilisateur.
model WalletAccount {
  id          String    @id @default(uuid()) @db.Uuid
  userId      Int       @unique @map("user_id")
  currency    String    @default("CDF")
  status      String    @default("DISABLED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("wallet_accounts")
}

/// Écriture du grand livre du portefeuille, en débit ou en crédit.
model WalletLedgerEntry {
  id             String    @id @default(uuid()) @db.Uuid
  walletAccountId String   @map("wallet_account_id") @db.Uuid
  /// Sens de l’écriture : CREDIT ou DEBIT.
  direction      String
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("CDF")
  status         String    @default("PENDING")
  referenceType  String    @map("reference_type")
  referenceId    String    @map("reference_id")
  description    String?
  createdAt      DateTime  @default(now())
  postedAt       DateTime? @map("posted_at")

  @@map("wallet_ledger_entries")
  @@unique([walletAccountId, referenceType, referenceId, direction])
  @@index([walletAccountId, createdAt])
}

/// Pourboire séparé versé au livreur après une livraison réussie.
model Tip {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        Int       @map("commande_id")
  deliveryId     String?   @map("delivery_id")
  customerId     Int       @map("customer_id")
  delivererId    Int       @map("livreur_id")
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("CDF")
  paymentMethod  String?   @map("payment_method")
  transactionId  String?   @unique @map("transaction_id")
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  paidAt         DateTime? @map("paid_at")

  @@map("tips")
  @@index([orderId, status])
  @@index([delivererId, status])
}

/// Notification reçue d’un prestataire de paiement, conservée pour audit et idempotence.
model PaymentWebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  externalEventId String?  @map("external_event_id")
  transactionId  String?   @map("transaction_id")
  /// Payload original reçu du prestataire pour audit et rejeu contrôlé.
  payload        Json
  /// Indique si la signature du webhook a été vérifiée avec succès.
  signatureValid Boolean   @map("signature_valid")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now())

  @@map("payment_webhook_events")
  @@unique([provider, externalEventId])
  @@index([transactionId])
}

/// Résultat mis en cache d’une recherche d’adresse auprès de Nominatim.
model GeocodingCache {
  id          String    @id @default(uuid()) @db.Uuid
  /// Empêche de refaire plusieurs fois la même requête Nominatim.
  cacheKey    String    @unique @map("cache_key")
  provider    String    @default("nominatim")
  query       Json
  displayName String?   @map("display_name")
  latitude    Float?
  longitude   Float?
  raw          Json
  /// Date à partir de laquelle le résultat doit être recalculé.
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("geocoding_cache")
  @@index([expiresAt])
}

/// Trace d’audit d’une action importante réalisée dans l’application.
model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  parseObjectId String?   @unique
  action        String?
  details       String?
  userName      String?
  country       String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("audit_logs")
  @@index([createdAt])
  @@index([action])
}

/// Facture générée à partir d’une commande.
model Invoice {
  id                String    @id @default(uuid()) @db.Uuid
  parseObjectId     String?   @unique
  invoiceId         String    @unique
  orderId           Int       @map("commande_id")
  restaurantId      Int?
  restaurantName    String?
  restaurantAddress String?
  rccm              String?
  restaurantPhone   String?
  customerName      String?
  invoiceDate       DateTime?
  items             Json?
  subtotal          Decimal?  @db.Decimal(14, 2)
  deliveryFee       Decimal?  @db.Decimal(14, 2)
  totalCdf          Decimal?  @map("total_cdf") @db.Decimal(14, 2)
  totalUsd          Decimal?  @map("total_usd") @db.Decimal(14, 2)
  exchangeRate      Decimal?  @db.Decimal(18, 6)
  currency          String?
  pdfUrl            String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("invoices")
  @@index([orderId])
  @@index([restaurantId])
}

/// Paiement périodique dû à un restaurant.
model RestaurantPayout {
  id                   String    @id @default(uuid()) @db.Uuid
  parseObjectId        String?   @unique
  payoutId             Int       @unique @map("paiement_id")
  restaurantId         Int
  restaurateurId       Int?
  restaurantName       String?
  weekStart            DateTime
  weekEnd              DateTime
  totalOrders          Int?
  totalSubtotal        Decimal?  @db.Decimal(14, 2)
  totalDeliveryFees    Decimal?  @db.Decimal(14, 2)
  commissionRate       Float?
  totalCommission      Decimal?  @db.Decimal(14, 2)
  netAmount            Decimal?  @db.Decimal(14, 2)
  status               String?
  payoutMethod         String?
  mobileMoneyPhone     String?
  iban                 String?
  payoutRef            String?
  paidAt               DateTime?
  errorMessage         String?
  cityId               Int?
  commissionInvoiceUrl String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("restaurant_payouts")
  @@index([restaurantId])
  @@index([status])
  @@index([weekStart, weekEnd])
}

/// Paiement périodique dû à un livreur.
model DelivererPayout {
  id               String    @id @default(uuid()) @db.Uuid
  parseObjectId    String?   @unique
  payoutId         Int       @unique @map("paiement_id")
  delivererId      Int
  delivererName    String?
  weekStart        DateTime
  weekEnd          DateTime
  totalDeliveries  Int?
  totalBasePay     Decimal?  @db.Decimal(14, 2)
  totalDistancePay Decimal?  @db.Decimal(14, 2)
  totalTips        Decimal?  @db.Decimal(14, 2)
  netAmount        Decimal?  @db.Decimal(14, 2)
  status           String?
  payoutMethod     String?
  mobileMoneyPhone String?
  iban             String?
  payoutRef        String?
  paidAt           DateTime?
  errorMessage     String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("deliverer_payouts")
  @@index([delivererId])
  @@index([status])
  @@index([weekStart, weekEnd])
}

/// Abonnement souscrit par un restaurant.
model Subscription {
  id             String    @id @default(uuid()) @db.Uuid
  parseObjectId  String?   @unique
  subscriptionId Int       @unique
  restaurantId   Int
  restaurantName String?
  plan           String?
  price          Decimal?  @db.Decimal(14, 2)
  currency       String?
  startDate      DateTime?
  endDate        DateTime?
  status         String?
  autoRenew      Boolean   @default(false)
  paymentMethod  String?
  paymentRef     String?
  features       Json?
  cityId         Int?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("subscriptions")
  @@index([restaurantId])
  @@index([status])
}
